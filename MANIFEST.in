include LICENSE
include README.md
include pyproject.toml
recursive-include configs *.yaml
recursive-include docs *.md
recursive-include docs/assets *.png
recursive-include resource_builder *.py *.md *.txt
recursive-include scripts *.sh
recursive-include src/prom3theus *.py
recursive-include src/prom3theus/resources/data *.json
recursive-include src/prom3theus/resources/sets *.json
prune tests
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude __pycache__
